            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/coaches/{{coachId}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "coaches",
                "{{coachId}}",
                "booking"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientName\": \"Иванова Софья\",\n  \"clientPhone\": \"+79001234567\",\n  \"childName\": \"Иванова Софья\",\n  \"childAge\": 7,\n  \"consent\": true\n}"
            }
          }
        },
