{
  "info": {
    "name": "ProtrenerovKids.ru API",
    "description": "Сгенерировано на основе API.md. Перед использованием: 1) запустить сервер (npm run dev), 2) прогнать npm run prisma:seed и скопировать токены из вывода в переменные коллекции adminToken/managerToken/coachToken.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "superAdminToken",
      "value": "вставьте токен SUPER_ADMIN из вывода npm run prisma:seed"
    },
    {
      "key": "managerToken",
      "value": "вставьте токен MANAGER (Аня) из вывода npm run prisma:seed"
    },
    {
      "key": "coachToken",
      "value": "вставьте токен COACH (Елена) из вывода npm run prisma:seed"
    },
    {
      "key": "coachId",
      "value": ""
    },
    {
      "key": "reviewId",
      "value": ""
    },
    {
      "key": "callRecordId",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "claimToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Публичный каталог",
      "item": [
        {
          "name": "Список тренеров",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/coaches?sport=figure_skating",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "coaches"
              ],
              "query": [
                {
                  "key": "sport",
                  "value": "figure_skating"
                }
              ]
            }
          }
        },
        {
          "name": "Профиль тренера",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/coaches/{{coachId}}",
